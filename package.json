{
  "name": "chronicle",
  "version": "0.1.0",
  "description": "Сервис итогов рабочих сессий агентов: знания, сделанная работа, активное время",
  "license": "MIT-0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/a-kalki/chronicle.git"
  },
  "type": "module",
  "private": true,
  "bin": {
    "chronicle": "./src/cli/main.ts"
  },
  "scripts": {
    "test": "bun test",
    "lint": "bunx biome check .",
    "typecheck": "bunx tsc --noEmit",
    "check": "bun run lint && bun run typecheck && bun test",
    "link": "mkdir -p ~/.local/bin && ln -sf \"$PWD/src/cli/main.ts\" ~/.local/bin/chronicle && echo \"chronicle → ~/.local/bin/chronicle\""
  },
  "dependencies": {
    "@valibot/to-json-schema": "^1.8.0",
    "valibot": "^1.5.0"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.13",
    "@types/bun": "^1.4.3",
    "typescript": "^7.0.2"
  }
}
